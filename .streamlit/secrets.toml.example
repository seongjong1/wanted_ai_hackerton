# Copy to secrets.toml locally; paste these fields into Cloud > Settings > Secrets.
# Use the decoded DATA.GO.KR service key. Encoded keys are also normalized once.
DATA_GO_KR_API_KEY = ""
KAKAO_REST_API_KEY = ""
GROQ_API_KEY = ""
# Enable diagnostics only during development; requests consume API quota.
ENABLE_API_DIAGNOSTICS = false
EXTENDED_ACTIVITY_RADIUS_METERS = 2000

# LOCAL_ORIGIN: coordinate lookup cap for rail and bus catalogs; nearest hubs per mode
LOCAL_ORIGIN_HUB_SCAN_LIMIT = 12
LOCAL_ORIGIN_HUB_LIMIT = 3

# Estimated activity durations; never presented as venue-provided facts.
SCHEDULE_MEAL_MINUTES = 60
SCHEDULE_SIGHTSEEING_MINUTES = 60
SCHEDULE_SHOPPING_MINUTES = 60
SCHEDULE_EXPERIENCE_MINUTES = 90
SCHEDULE_REST_MINUTES = 30
SCHEDULE_DEFAULT_MINUTES = 60
MAX_SCHEDULE_ROUTE_CALLS = 24
MAX_SCHEDULE_ATTEMPTS = 2
MIN_SUPPORTING_ACTIVITY_GAP_MINUTES = 60
LATE_LUNCH_END_HOUR = 16
MAX_GAP_FILL_ITERATIONS = 4
GAP_SAFETY_BUFFER_MINUTES = 5
